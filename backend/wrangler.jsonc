// HIUNNI API Worker — staging/local candidate. NOT the production worker.
// database_id / bucket names are placeholders: replace with the client's own
// Cloudflare account resources once access is granted (see README).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hiunni-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  // Serves the web prototype (../web) from the same origin as the API.
  // Paths that are not files fall through to the Worker.
  "assets": { "directory": "../web" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "hiunni-db",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "hiunni-media" }],
  "durable_objects": {
    "bindings": [{ "name": "HUB", "class_name": "ChannelHub" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ChannelHub"] }],
  // F05: deliver queued pushes and retries every minute (src/lib/push-send.ts).
  // Sending needs the secret FCM_SERVICE_ACCOUNT; without it the run does nothing.
  "triggers": { "crons": ["* * * * *"] },
  "vars": {
    "ENVIRONMENT": "development",
    "DEV_LOGIN_ENABLED": "true",
    "ALLOWED_ORIGINS": "http://localhost:8787,http://localhost:5173,capacitor://localhost,https://localhost"
  },
  "env": {
    // Client demo on the developer's own Cloudflare account: synthetic seed data, dev login on.
    // Deploy: npx wrangler deploy --env staging
    // R2 is not enabled on this account yet, so photo upload/view returns an error here.
    // After enabling R2: create bucket hiunni-media-staging and add
    //   "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "hiunni-media-staging" }]
    "staging": {
      "name": "hiunni-api-staging",
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "hiunni-db-staging",
          "database_id": "34aa4dbb-25ae-45b1-a894-286075133edf",
          "migrations_dir": "migrations"
        }
      ],
      "durable_objects": {
        "bindings": [{ "name": "HUB", "class_name": "ChannelHub" }]
      },
      "triggers": { "crons": ["* * * * *"] },
      "vars": {
        "ENVIRONMENT": "development",
        "DEV_LOGIN_ENABLED": "true",
        "ALLOWED_ORIGINS": "https://hiunni-demo.vercel.app"
      }
    }
  }
}
