<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Push (APNs). Xcode switches this to production when archiving for the App Store. -->
	<key>aps-environment</key>
	<string>development</string>
	<!-- Universal Links: needs hiunni.kr/.well-known/apple-app-site-association with the Team ID. -->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:hiunni.kr</string>
	</array>
</dict>
</plist>
